---
// Parallax for any [data-parallax] layer that is taller than its parent section.
// While the section travels into place, the layer lags behind the content and
// settles at offset 0 once the section has arrived (for stacking cards, the
// moment the card sticks), so the settled framing is the designed one.
---
<script is:inline>
(() => {
  const layers = [...document.querySelectorAll('[data-parallax]')];
  if (!layers.length) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let raf = 0;

  const update = () => {
    raf = 0;
    const vh = innerHeight;
    for (const layer of layers) {
      const host = layer.parentElement;
      const extra = layer.offsetHeight - host.offsetHeight;
      if (reduce.matches || extra <= 0) { layer.style.transform = ''; continue; }
      const top = host.getBoundingClientRect().top;
      const arrived = Math.min(0, vh - host.offsetHeight); // where a tall card sticks
      const p = Math.min(1, Math.max(0, (vh - top) / (vh - arrived)));
      layer.style.transform = `translate3d(0, ${(-(1 - p) * extra).toFixed(1)}px, 0)`;
    }
  };

  const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);
  reduce.addEventListener('change', schedule);
  update();
})();
</script>
