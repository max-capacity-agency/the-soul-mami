---
// Slow blurred honey waves. Place as the first child of a `section.witnessed`
// (styles live in global.css). Testimonials always sit on these waves.
---
<div class="honey-waves" aria-hidden="true">
  <span class="wave wave--honey"></span>
  <span class="wave wave--amber"></span>
  <span class="wave wave--clay"></span>
  <span class="wave wave--olive"></span>
</div>
