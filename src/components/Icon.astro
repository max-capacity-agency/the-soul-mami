---
// Hand-drawn line icons for the round badges (doorway cards, Free Honey cards).
// One style throughout: slightly wobbly 1.8px bark strokes, round ends, and a
// single honey-filled accent per icon. Colour comes from the badge (currentColor).
interface Props {
  name: 'notebook' | 'candle' | 'notes' | 'pencil' | 'headphones' | 'mic' | 'books' | 'sprout' | 'podcast';
  size?: number;
}
const { name, size = 30 } = Astro.props;
---
<svg
  class="hand-icon"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'notebook' && (
    <>
      <path d="M9.2 5.4c3.9-.4 10.3-.2 14.2.2.6 6.9.5 14.2 0 21-4.1.4-10.3.5-14.3.1-.5-6.9-.5-14 .1-21.3Z" />
      <path class="hi-fill" d="M19.4 5.5v6.6l1.8-1.5 1.7 1.5V5.6" />
      <path d="M6.8 9.6h4.1M6.9 14.1h4M6.8 18.6h4.1M6.9 23.1h4" />
      <path d="M13.9 15.6c2.2-.2 4.4-.2 6.3.1M13.9 19.7c1.8-.1 3.6-.1 4.9 0" />
    </>
  )}
  {name === 'candle' && (
    <>
      <path class="hi-fill" d="M16 12.7c-2.3-1.2-2.7-3.7-1.3-5.7.5 1 1.1 1.4 1.6 1.2-.1-1.5.3-2.7 1.3-3.5.2 2.1 2.1 3.3 1.7 5.5-.3 1.6-1.5 2.6-3.3 2.5Z" />
      <path d="M16 15.1v-2.3" />
      <path d="M11.6 15.3c3-.4 5.9-.4 8.9.1l-.3 11.3c-2.8.4-5.6.4-8.4 0Z" />
      <path d="M14.8 15.4c0 1.7.3 2.6 1 2.7.6-.1.8-.9.7-2.5" />
      <path d="M8.4 27c4.9.7 10.2.7 15.1-.1" />
    </>
  )}
  {name === 'notes' && (
    <>
      <path d="M12.4 22.6V9.3c3.4-1 6.8-1.8 10.3-2.6v13.1" />
      <path d="M12.5 12.7c3.3-.9 6.7-1.7 10.1-2.4" />
      <path class="hi-fill" d="M7.9 23.6c.2-1.5 1.8-2.6 3.4-2.5 1.2.1 1.7.9 1.1 2-.7 1.3-2.3 2-3.6 1.8-.7-.2-1-.7-.9-1.3Z" />
      <path class="hi-fill" d="M18.2 20.9c.2-1.5 1.8-2.6 3.4-2.5 1.2.1 1.7.9 1.1 2-.7 1.3-2.3 2-3.6 1.8-.7-.2-1-.7-.9-1.3Z" />
    </>
  )}
  {name === 'pencil' && (
    <>
      <path d="M7.4 6.6c4.4-.5 9-.5 13.3 0 .4 6.4.4 12.6 0 19-4.3.4-8.9.4-13.2 0-.5-6.4-.5-12.6-.1-19Z" />
      <path d="M10.6 11.6c2.4-.2 4.7-.2 7 .1M10.6 15.6c1.8-.1 3.4-.1 5 0" />
      <path class="hi-fill" d="M15.4 24.7l9.5-9.8c.8-.8 2-.8 2.8 0 .8.8.8 2 0 2.8l-9.6 9.7-3.8 1Z" />
    </>
  )}
  {name === 'headphones' && (
    <>
      <path d="M7.6 19.4v-3.1C7.4 11 11.2 7.2 16 7.3c4.9 0 8.6 3.8 8.5 9v3.1" />
      <path class="hi-fill" d="M6.9 18.6c1.6-.5 3.3-.3 3.9.6l.4 6.2c-.6 1-2.3 1.2-3.8.7-.8-2.4-.9-5-.5-7.5Z" />
      <path class="hi-fill" d="M25.1 18.6c-1.6-.5-3.3-.3-3.9.6l-.4 6.2c.6 1 2.3 1.2 3.8.7.8-2.4.9-5 .5-7.5Z" />
    </>
  )}
  {name === 'mic' && (
    <>
      <path class="hi-fill" d="M12.3 9.7c-.1-2.3 1.7-4.2 3.8-4.2 2.2 0 3.8 1.9 3.7 4.2v4.5c0 2.2-1.6 4-3.7 4-2.2 0-3.8-1.8-3.8-4Z" />
      <path d="M9.3 13.5c.1 4 3 6.9 6.8 6.9 3.7 0 6.6-2.9 6.6-6.9" />
      <path d="M16.1 20.5v5.3M12.1 26.2c2.7.3 5.4.3 8 0" />
    </>
  )}
  {name === 'books' && (
    <>
      <path d="M6.5 20.6c6.3-.6 12.6-.6 18.9 0l-.2 5.4c-6.1.5-12.3.5-18.5 0Z" />
      <path d="M9.4 23.3c4.4-.3 8.8-.3 13.1 0" />
      <path class="hi-fill" d="M8.8 14.5c5-.9 10.3-1.1 15.3-.6l-.1 5c-5 .1-10 .4-15 1Z" />
      <path d="M10.9 10.9c3.5-.8 7.1-1.1 10.6-.8" />
    </>
  )}
  {name === 'sprout' && (
    <>
      <path d="M7 25.7c6 .7 12.1.7 18.1-.1" />
      <path d="M16 25.4c-.2-4.2 0-8 .4-11.7" />
      <path class="hi-fill" d="M16.1 17.3c-3.9.4-7.1-1.7-7.9-5.6 3.9-.6 7 1.4 7.9 5.6Z" />
      <path class="hi-fill" d="M16.5 13.7c.5-4.2 3.6-6.9 7.6-6.8-.1 4-3.4 6.8-7.6 6.8Z" />
    </>
  )}
  {name === 'podcast' && (
    <>
      <path class="hi-fill" d="M7 8.7c5.9-.8 12.2-.8 18 0 .6 3.7.6 7.4 0 11.1-3.7.5-7.5.6-11.2.4l-4.3 4.2.4-4.6c-1-.1-2-.2-2.9-.3-.6-3.6-.6-7.2 0-10.8Z" />
      <path d="M12 12.7v3.6M15 11.2v6.6M18 12.3v4.4M21 13.3v2.4" />
    </>
  )}
</svg>

<style>
  .hand-icon { display: block; }
  .hand-icon .hi-fill { fill: var(--honey); }
</style>
