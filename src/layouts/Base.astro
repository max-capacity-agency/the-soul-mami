---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GardenCTA from '../components/GardenCTA.astro';

interface Props {
  title: string;
  description?: string;
  hideGarden?: boolean;
}
const {
  title,
  description = 'The Soul Mami — tools, songs, and honest words for coming home to yourself. Journaling masterminds, 1:1 mentoring, and music by Eliana Reyes.',
  hideGarden = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Karla:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    {!hideGarden && <GardenCTA />}
    <Footer />
  </body>
</html>
