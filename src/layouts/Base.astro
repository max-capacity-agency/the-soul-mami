---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GardenCTA from '../components/GardenCTA.astro';
import BlurInText from '../components/BlurInText.astro';
import { SHARE_IMAGE, GA_MEASUREMENT_ID } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  hideGarden?: boolean;
  /** Link-preview image for this page (site-relative). Defaults to the site's share image. */
  image?: string;
}
const {
  title,
  description = 'The Soul Mami: tools, songs, and honest words for coming home to yourself. The Journaling Hive, 1:1 mentoring, and music by Eliana, the Soul Mami.',
  hideGarden = false,
  image = SHARE_IMAGE,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Soul Mami" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eliana, the Soul Mami, smiling by the water, with the words Remember your soul" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('bi');
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Young+Serif&family=Hanken+Grotesk:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    {!hideGarden && <GardenCTA />}
    <Footer />
    <BlurInText />
  </body>
</html>
