---
import Base from '../layouts/Base.astro';
import Bee from '../components/Bee.astro';
import { mailchimp } from '../lib/mailchimp';
import GardenSignup from '../components/GardenSignup.astro';
---
<Base title="Join my Garden | The Soul Mami" hideGarden={true} description="Join Eliana's garden: letters with journal entries, new songs, free tools for self-connection, and first word on the next Hive gathering.">

  <section class="section garden-hero honeycomb">
    <div class="wrap prose center">
      <span class="eyebrow">The Garden</span>
      <h1>Get planted, <em class="soul">mami</em></h1>
      <p class="lead">
        The garden is my email list, but it doesn't feel like one.
        It's letters from me to you: fresh journal entries, new songs
        before anyone else hears them, tools for self-connection, and
        first word on the next Hive gathering.
      </p>
      <ul class="garden-list">
        <li>One or two letters a month. That's it.</li>
        <li>Real words from a real human.</li>
        <li>First access to Hive gatherings, music, and goodies.</li>
        <li>Leave anytime. The gate never locks.</li>
      </ul>
      <!-- Signups go to Mailchimp once src/lib/mailchimp.ts has the form URL; until then Netlify Forms keeps them. -->
      <form
        class="garden-form"
        name="garden"
        method="POST"
        {...(mailchimp
          ? { action: mailchimp.action, target: '_blank', rel: 'noopener', 'data-mailchimp': '' }
          : { 'data-netlify': 'true' })}
      >
        {!mailchimp && <input type="hidden" name="form-name" value="garden" />}
        <label class="visually-hidden" for="garden-page-name">First name (optional)</label>
        <input class="garden-name" id="garden-page-name" type="text" name={mailchimp ? 'FNAME' : 'name'} placeholder="First name" autocomplete="given-name" />
        <label class="visually-hidden" for="garden-page-email">Email address</label>
        <input class="garden-email" id="garden-page-email" type="email" name={mailchimp ? 'EMAIL' : 'email'} placeholder="Your email, mami" autocomplete="email" required />
        {mailchimp && (
          <div class="bot-trap" aria-hidden="true"><input type="text" name={mailchimp.honeypot} tabindex="-1" value="" autocomplete="off" /></div>
        )}
        <button class="btn btn--primary" type="submit">Plant me in</button>
      </form>
      <p class="garden-status" role="status" aria-live="polite" hidden></p>
      <GardenSignup />
      <div style="margin-top:2rem;"><Bee size={34} /></div>
      <img class="photo garden-photo" src="/images/eliana-play.jpg" alt="Eliana laughing in sparkly novelty sunglasses" loading="lazy" />
    </div>
  </section>

</Base>

<style>
  .garden-hero { padding-block: clamp(4rem, 10vw, 7rem); }
  .garden-list {
    list-style: none;
    margin: 1.5rem auto 2rem;
    padding: 0;
    max-width: 30rem;
    text-align: left;
  }
  .garden-list li {
    padding: 0.55rem 0 0.55rem 1.8rem;
    position: relative;
  }
  .garden-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: var(--honey);
  }
  .garden-form {
    display: flex;
    gap: 0.75rem;
    max-width: 38rem;
    margin-inline: auto;
  }
  .garden-form .garden-name { flex: 0.7; min-width: 0; }
  .garden-form .garden-email { flex: 1; min-width: 0; }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .garden-form { flex-direction: column; }
  }
  .garden-photo {
    width: min(260px, 70vw);
    height: auto;
    margin: 2rem auto 0;
    border-radius: 50%;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>
