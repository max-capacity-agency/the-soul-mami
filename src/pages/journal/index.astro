---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Journal | The Soul Mami" description="Eliana's journal, not a blog. Honest entries from the journey of living life: the messy, the holy, the hilarious. Come read slowly.">

  <section class="section hero">
    <div class="wrap prose center">
      <span class="eyebrow">The Journal</span>
      <h1>Me, on <em class="soul">paper</em></h1>
      <p class="lead">
        This isn't a blog. It's my journal, cracked open. Entries from
        the journey of living life, the different human experiences,
        as they happen. Read slowly. Come back often. The archives
        aren't going anywhere.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap archive">
      {entries.map((e) => (
        <a class="entry" href={`/journal/${e.id}/`}>
          <p class="muted date">{fmt(e.data.date)}</p>
          <h2>{e.data.title}</h2>
          <p>{e.data.excerpt}</p>
          <span class="read">Keep reading &rarr;</span>
        </a>
      ))}
    </div>
  </section>

</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .archive {
    max-width: var(--maxw-text);
    margin-inline: auto;
    display: grid;
    gap: 0;
  }
  .entry {
    display: block;
    text-decoration: none;
    color: inherit;
    padding-block: 2.2rem;
    border-bottom: 1px solid var(--sand-deep);
  }
  .entry:first-child { border-top: 1px solid var(--sand-deep); }
  .entry h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.4em; }
  .entry:hover h2 { color: var(--clay); }
  .date { font-size: 0.88rem; margin-bottom: 0.5rem; }
  .read { color: var(--clay); font-weight: 700; }
</style>
