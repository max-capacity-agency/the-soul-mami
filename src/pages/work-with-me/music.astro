---
import Base from '../../layouts/Base.astro';
import GardenCTA from '../../components/GardenCTA.astro';
import StackCards from '../../components/StackCards.astro';
---
<Base hideGarden={true} title="Music | The Soul Mami" description="Original songs by Eliana Reyes, independent artist. Music as another doorway into self-connection. Listen on Spotify.">

  <!-- Beat: Invitation -->
  <section class="section hero">
    <div class="wrap prose center">
      <span class="eyebrow">Listen</span>
      <h1>Songs for the journey <em class="soul">home</em></h1>
      <p class="lead">
        Same soul, different doorway. Some truths won't sit still in a
        sentence, so I sing them. These songs come from the exact same
        place as the circles and the journal: the practice of being
        fully, honestly alive.
      </p>
    </div>
  </section>

  <!-- From here down, each section stacks over the last like a card. -->
  <div class="stack">

  <!-- Beat: The Songs -->
  <section class="section" style="padding-top:0;">
    <div class="wrap tracks">
      <!-- TODO: track titles + the story behind each song from Eliana -->
      <div class="track">
        <iframe
          title="Listen on Spotify: track one"
          src="https://open.spotify.com/embed/track/2ybpZWpAaFt0XiwCFNeltB"
          width="100%" height="232" frameborder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
        <p class="muted">The story behind this one is coming. For now, just press play and feel it.</p>
      </div>
      <div class="track">
        <iframe
          title="Listen on Spotify: track two"
          src="https://open.spotify.com/embed/track/7CoNuwBPZTLeqnS7lMdR6L"
          width="100%" height="232" frameborder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
        <p class="muted">The story behind this one is coming. For now, just press play and feel it.</p>
      </div>
    </div>
  </section>

  <!-- Beat: Next -->
  <section class="section section--sand">
    <div class="wrap prose center">
      <span class="eyebrow">Coming Soon</span>
      <h2>The next song is in the hive.</h2>
      <p class="lead">
        A new track is being made right now. Garden members hear it
        first, with the story of where it came from.
      </p>
      <a class="btn btn--honey" href="/garden/">Hear it first</a>
    </div>
  </section>

  <!-- Beat: Why Music -->
  <section class="section">
    <div class="wrap prose">
      <span class="eyebrow">Why Music</span>
      <h2>Because we don't only heal in words.</h2>
      <p class="lead">
        I believe we learn through story, movement, relationship,
        reflection, and play. Music is where all five meet.
      </p>
      <p>
        A song can reach the part of you that's tired of being talked
        at. It can hold you while you journal, crack you open on a
        drive, or remind you at 2am that someone else has felt this
        too. That's why the music lives here, right next to the
        mentoring and the mastermind. It's not a side project. It's
        one of the drawers.
      </p>
    </div>
  </section>

  <GardenCTA />

  </div>
  <StackCards />

</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .tracks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin-inline: auto;
  }
  .track iframe { border-radius: 14px; border: 0; }
  .track p { margin-top: 0.9rem; font-size: 0.95rem; }
  @media (max-width: 760px) {
    .tracks { grid-template-columns: 1fr; }
  }
</style>
